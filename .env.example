# ============================================================
# 环境配置模板（.env.example）
#
# 用法：
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#   然后编辑 .env 填入真实值。
#
# 安全须知：
#   - 真实密钥只写入 .env；.env 已在 .gitignore 中，**严禁提交**
#   - 本模板（.env.example）只含占位值，是**唯一**入库的配置载体
#   - 优先级：系统环境变量 > .env 文件 > 代码默认值（config/settings.py）
#   - 生产部署：优先用系统环境变量或云密钥服务注入，服务器上不放 .env 文件
#   - 密钥申请：https://dashscope.console.aliyun.com/apiKey （阿里云百炼）
# ============================================================

# ===== LLM（必填）：阿里云百炼 DashScope，OpenAI 兼容接口 =====
MODEL_API_KEY=sk-your-dashscope-api-key-here
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-flash

# ===== Neo4j 图数据库（docker-compose 默认账号 neo4j / 12345678）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# ===== BGE-M3 嵌入模型本地路径（相对项目根目录或绝对路径）=====
EMBEDDING_MODEL_PATH=models/bge-m3

# ===== 可观测 tracing（可选，实现见 src/common/observe.py；不配置 = no-op 零开销）=====
# LangSmith（推荐）：https://smith.langchain.com 申请 key 后去注释启用，
# 启用后 langchain 自动 trace 整棵调用树（节点/LLM/tool_calls），生产与评估共用
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # 美云默认值；EU 区域改 eu.api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2-your-key-here
# LANGSMITH_PROJECT=smart-medical-consultation
# Langfuse（自托管备选，配置后优先于 LangSmith）：docker 自托管后填写启用
# LANGFUSE_PUBLIC_KEY=pk-your-key
# LANGFUSE_SECRET_KEY=sk-your-key
# LANGFUSE_HOST=http://localhost:3000

# ===== 对话历史存储（Redis 热缓存 + MySQL 冷存储，docker-compose 一并拉起）=====
REDIS_URL=redis://localhost:6379/0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=smc_history

# ===== 用户认证（JWT，讲义 §7）=====
# 签名密钥：执行 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
# 留空=每次启动随机生成，重启后所有登录态失效（仅适合开发环境）
# JWT_SECRET=please-change-to-a-random-string
# ACCESS_TOKEN_EXPIRE_MINUTES=120     # 访问令牌有效期（分钟）

# ===== CORS 允许来源（逗号分隔）=====
# 开启认证后不再允许 "*"。开发=Vite :5173；生产单进程同源部署无需配置
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 日志级别：DEBUG / INFO / WARNING / ERROR =====
LOG_LEVEL=INFO

# ===== 抽取微调模型（可选）：想让实体/关系抽取走自部署 vLLM 微调模型时才填 =====
# 切换只需改 EXTRACTION_MODEL_BASE_URL：留空=抽取回退主 LLM（全云端）；填入=仅抽取走本地微调模型
# EXTRACTION_MODEL_BASE_URL=http://<GPU服务器IP>:8000/v1
# EXTRACTION_MODEL_API_KEY=EMPTY
# EXTRACTION_MODEL_NAME=qwen2.5-merged    # 需与 vLLM 启动时的 --served-model-name 一致

# ===== 可选调优项（保持注释 = 使用代码默认值）=====
# --- 答案缓存（L1 Redis 精确 + L2 语义，实现见 src/common/answer_cache.py）---
# 仅无历史的独立首问参与命中；多轮上下文问题直通。命中直返完整响应（含免责声明）
# CACHE_ENABLED=true                  # 总开关；跑评估基线对比时可设 false
# CACHE_VERSION=v1                    # 知识库/图谱重建后改个新值 = 缓存整体失效
# CACHE_L1_TTL_SECONDS=86400          # L1 精确缓存 TTL（秒），版本更新才是主失效手段
# CACHE_SIMILARITY_THRESHOLD=0.92     # L2 语义命中阈值（医疗场景从严，勿随意调低）
# CACHE_L2_MAX_ENTRIES=256            # L2 容量上限（FIFO 淘汰）
# --- 多轮上下文 Token 预算（§6.6：计数+滑窗+摘要）---
# HISTORY_MAX_TURNS=12                # 热缓存/上下文窗口轮次硬上限
# HISTORY_MAX_TOKENS=3000             # 注入提示词的历史段 token 预算（保守估算）
# HISTORY_SUMMARY_MIN_KEEP=4          # 增量摘要时至少原文保留的最近轮次数
# HISTORY_SUMMARY_MAX_CHARS=600       # 滚动摘要最大字符数（硬截断保险丝）
# API_PORT=8000                       # FastAPI 端口
# LLM_ENABLE_THINKING=false           # qwen3 思考(reasoning)模式：默认关(快)，复杂医学推理可设 true
# LLM_MAX_RETRIES=1                   # LLM 失败重试次数：延迟敏感建议 ≤1
# ENABLE_REACT_LAYER=true             # 医学知识分支是否启用可选 ReAct 多跳层
# CHECKPOINT_ENABLED=true             # LangGraph 执行态持久化（thread_id 落盘：可中断恢复/可回溯/重启不丢）
                                      # 注意：checkpoint 不是事实源，对话记录仍以 MySQL 为准；详见 src/agents/checkpointer.py
# CHECKPOINT_DB_PATH=data/checkpoints/agent_checkpoints.sqlite   # 运行时产物，已进 .gitignore
# ENTITY_LINK_THRESHOLD=0.85          # 实体链接相似度阈值（越高越严格）
# ENTITY_LINK_TOP_K=3                 # 实体链接每词考察候选数
# TEXT2CYPHER_ENABLED=true            # 是否为 ReAct 层提供 Text2Cypher 工具
# TEXT2CYPHER_MAX_RECORDS=50          # Text2Cypher 单次查询返回记录上限
